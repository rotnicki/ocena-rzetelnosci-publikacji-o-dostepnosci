{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rotnicki/ocena-rzetelnosci-publikacji-o-dostepnosci/feature/0.3-draft/metodologia/0.3/wyciag-kalibracyjny.schema.json",
  "title": "Wyciąg kalibracyjny oceny publikacji o dostępności 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "publication_id", "methodology", "evaluator", "material_versions",
    "publication_context_summary", "audience_language", "claim_count", "claim_map_confidence", "scores",
    "issue_counts", "issues", "central_findings", "verdict", "verdict_confidence", "source_coverage",
    "counterfactual_correction"
  ],
  "properties": {
    "schema_version": {"const": "0.3-draft"},
    "analysis_id": {"type": "string", "minLength": 1},
    "publication_id": {"type": "string", "minLength": 1},
    "methodology": {
      "type": "object", "additionalProperties": false, "required": ["version", "identifier"],
      "properties": {"version": {"const": "0.3-draft"}, "identifier": {"type": "string", "minLength": 1}}
    },
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "material_versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/materialVersion"}},
    "publication_context_summary": {"$ref": "#/$defs/contextSummary"},
    "audience_language": {"$ref": "#/$defs/audienceLanguage"},
    "claim_count": {"type": "integer", "minimum": 0},
    "claim_map_confidence": {"$ref": "#/$defs/confidence"},
    "scores": {"$ref": "#/$defs/scores"},
    "issue_counts": {"$ref": "#/$defs/issueCounts"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/calibrationIssue"}},
    "central_findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verdict": {"$ref": "#/$defs/verdict"},
    "verdict_confidence": {"$ref": "#/$defs/confidence"},
    "source_coverage": {"enum": ["pelne", "wystarczajace", "czesciowe", "niewystarczajace"]},
    "counterfactual_correction": {"enum": ["ograniczona", "strukturalna", "nie_dotyczy"]}
  },
  "$defs": {
    "confidence": {"enum": ["wysoka", "srednia", "niska"]},
    "scoreValue": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 4}, {"const": "nd"}]},
    "scores": {
      "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"],
      "properties": {"A": {"$ref": "#/$defs/scoreValue"}, "B": {"$ref": "#/$defs/scoreValue"}, "C": {"$ref": "#/$defs/scoreValue"}, "D": {"$ref": "#/$defs/scoreValue"}, "E": {"$ref": "#/$defs/scoreValue"}, "F": {"$ref": "#/$defs/scoreValue"}, "G": {"$ref": "#/$defs/scoreValue"}, "H": {"$ref": "#/$defs/scoreValue"}, "I": {"$ref": "#/$defs/scoreValue"}, "J": {"$ref": "#/$defs/scoreValue"}, "K": {"$ref": "#/$defs/scoreValue"}, "L": {"$ref": "#/$defs/scoreValue"}}
    },
    "issueCounts": {
      "type": "object", "additionalProperties": false, "required": ["krytyczne", "duze", "srednie", "male"],
      "properties": {"krytyczne": {"type": "integer", "minimum": 0}, "duze": {"type": "integer", "minimum": 0}, "srednie": {"type": "integer", "minimum": 0}, "male": {"type": "integer", "minimum": 0}}
    },
    "verdict": {"enum": ["rzetelny", "rzetelny_z_niewielkimi_zastrzezeniami", "rzetelny_z_istotnymi_zastrzezeniami", "nierzetelny", "nie_mozna_rozstrzygnac"]},
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "model_snapshot", "reasoning_setting", "tools", "memory_access", "project_access", "private_repository_access"],
      "properties": {
        "type": {"enum": ["czlowiek", "ai", "zespol"]}, "name": {"type": "string", "minLength": 1},
        "model_snapshot": {"type": "string", "minLength": 1}, "reasoning_setting": {"type": "string", "minLength": 1},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}, "memory_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]},
        "project_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]}, "private_repository_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]}
      }
    },
    "materialVersion": {
      "type": "object", "additionalProperties": false, "required": ["material_id", "role", "url", "version"],
      "properties": {"material_id": {"type": "string", "minLength": 1}, "role": {"enum": ["tresc_glowna", "material_centralny_zewnetrzny"]}, "url": {"type": "string", "format": "uri"}, "version": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}
    },
    "contextSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["outlet_type", "outlet_declared_purpose", "declared_audiences", "article_audiences", "actually_required_knowledge", "conflicts", "profile_status", "profile_confidence"],
      "properties": {
        "outlet_type": {"type": "string", "minLength": 1}, "outlet_declared_purpose": {"type": "string", "minLength": 1},
        "declared_audiences": {"type": "array", "items": {"type": "string", "minLength": 1}}, "article_audiences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actually_required_knowledge": {"type": "array", "items": {"type": "string", "minLength": 1}}, "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "profile_status": {"enum": ["ustalony", "czesciowo_ustalony", "nieustalony_wiarygodnie"]}, "profile_confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "groupScore": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "significant", "included_in_article_promise", "group_h_score", "group_l_score"],
      "properties": {"audience": {"type": "string", "minLength": 1}, "significant": {"type": "boolean"}, "included_in_article_promise": {"type": "boolean"}, "group_h_score": {"type": "integer", "minimum": 0, "maximum": 4}, "group_l_score": {"type": "integer", "minimum": 0, "maximum": 4}}
    },
    "audienceLanguage": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_audience", "popularizing_purpose", "unexplained_core_terms_block_nonspecialists", "core_requires_undisclosed_specialist_knowledge", "core_unrecoverable_without_expert", "group_scores"],
      "properties": {
        "primary_audience": {"type": "string", "minLength": 1}, "popularizing_purpose": {"type": "boolean"},
        "unexplained_core_terms_block_nonspecialists": {"type": "boolean"}, "core_requires_undisclosed_specialist_knowledge": {"type": "boolean"},
        "core_unrecoverable_without_expert": {"type": "boolean"}, "group_scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/groupScore"}}
      }
    },
    "languageBarrier": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["locations", "audience_groups", "terms_or_structural_elements", "affected_dimensions"],
      "properties": {
        "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audience_groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terms_or_structural_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["G", "H", "L"]}}
      }
    },
    "calibrationIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "severity", "centrality", "centrality_rationale", "application_risk", "application_risk_rationale", "language_barrier", "confidence"],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^P-[0-9]{3,}$"}, "severity": {"enum": ["krytyczne", "duze", "srednie", "male"]},
        "centrality": {"enum": ["rdzen", "istotne_wsparcie", "element_poboczny"]}, "centrality_rationale": {"type": "string", "minLength": 1},
        "application_risk": {"enum": ["wysokie", "srednie", "niskie"]}, "application_risk_rationale": {"type": "string", "minLength": 1},
        "language_barrier": {"$ref": "#/$defs/languageBarrier"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
