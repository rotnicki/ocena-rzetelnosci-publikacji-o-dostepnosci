{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rotnicki/ocena-rzetelnosci-publikacji-o-dostepnosci/v0.3.0/metodologia/0.3/wyciag-kalibracyjny.schema.json",
  "title": "Wyciąg kalibracyjny oceny publikacji o dostępności 0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_id", "publication_id", "methodology", "evaluator", "material_versions",
    "publication_context_summary", "audience_language", "temporal_assessment", "dimension_applicability", "dimension_scope_checks", "decidability_test", "claim_count", "claim_map_confidence", "scores",
    "issue_counts", "issues", "central_findings", "verdict", "verdict_confidence", "source_coverage",
    "counterfactual_correction"
  ],
  "properties": {
    "schema_version": {"const": "0.3-draft"},
    "analysis_id": {"type": "string", "minLength": 1},
    "publication_id": {"type": "string", "minLength": 1},
    "methodology": {
      "type": "object", "additionalProperties": false, "required": ["version", "identifier"],
      "properties": {"version": {"const": "0.3-draft"}, "identifier": {"type": "string", "minLength": 1}}
    },
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "material_versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/materialVersion"}},
    "publication_context_summary": {"$ref": "#/$defs/contextSummary"},
    "audience_language": {"$ref": "#/$defs/audienceLanguage"},
    "temporal_assessment": {"$ref": "#/$defs/temporalAssessmentSummary"},
    "dimension_applicability": {"$ref": "#/$defs/dimensionApplicability"},
    "dimension_scope_checks": {"$ref": "#/$defs/dimensionScopeChecks"},
    "decidability_test": {"$ref": "#/$defs/decidabilityTest"},
    "claim_count": {"type": "integer", "minimum": 0},
    "claim_map_confidence": {"$ref": "#/$defs/confidence"},
    "scores": {"$ref": "#/$defs/scores"},
    "issue_counts": {"$ref": "#/$defs/issueCounts"},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/calibrationIssue"}},
    "central_findings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verdict": {"$ref": "#/$defs/verdict"},
    "verdict_confidence": {"$ref": "#/$defs/confidence"},
    "source_coverage": {"enum": ["pelne", "wystarczajace", "czesciowe", "niewystarczajace"]},
    "counterfactual_correction": {"enum": ["ograniczona", "strukturalna", "nie_dotyczy"]}
  },
  "$defs": {
    "confidence": {"enum": ["wysoka", "srednia", "niska"]},
    "scoreValue": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 4}, {"const": "nd"}]},
    "scores": {
      "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"],
      "properties": {"A": {"$ref": "#/$defs/scoreValue"}, "B": {"$ref": "#/$defs/scoreValue"}, "C": {"$ref": "#/$defs/scoreValue"}, "D": {"$ref": "#/$defs/scoreValue"}, "E": {"$ref": "#/$defs/scoreValue"}, "F": {"$ref": "#/$defs/scoreValue"}, "G": {"$ref": "#/$defs/scoreValue"}, "H": {"$ref": "#/$defs/scoreValue"}, "I": {"$ref": "#/$defs/scoreValue"}, "J": {"$ref": "#/$defs/scoreValue"}, "K": {"$ref": "#/$defs/scoreValue"}, "L": {"$ref": "#/$defs/scoreValue"}}
    },
    "issueCounts": {
      "type": "object", "additionalProperties": false, "required": ["krytyczne", "duze", "srednie", "male"],
      "properties": {"krytyczne": {"type": "integer", "minimum": 0}, "duze": {"type": "integer", "minimum": 0}, "srednie": {"type": "integer", "minimum": 0}, "male": {"type": "integer", "minimum": 0}}
    },
    "verdict": {"enum": ["rzetelny", "rzetelny_z_niewielkimi_zastrzezeniami", "rzetelny_z_istotnymi_zastrzezeniami", "nierzetelny", "nie_mozna_rozstrzygnac"]},
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "name", "model_snapshot", "reasoning_setting", "tools", "memory_access", "project_access", "private_repository_access"],
      "properties": {
        "type": {"enum": ["czlowiek", "ai", "zespol"]}, "name": {"type": "string", "minLength": 1},
        "model_snapshot": {"type": "string", "minLength": 1}, "reasoning_setting": {"type": "string", "minLength": 1},
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}, "memory_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]},
        "project_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]}, "private_repository_access": {"enum": ["tak", "nie", "not_available", "not_applicable"]}
      }
    },
    "materialVersion": {
      "type": "object", "additionalProperties": false, "required": ["material_id", "role", "url", "version"],
      "properties": {"material_id": {"type": "string", "minLength": 1}, "role": {"enum": ["tresc_glowna", "material_centralny_zewnetrzny"]}, "url": {"type": "string", "format": "uri"}, "version": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}}
    },
    "historicalVersionEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "preserved_content_date_or_version", "stable_identifier", "evidence_type", "scope"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "preserved_content_date_or_version": {"type": "string", "minLength": 1},
        "stable_identifier": {"type": "string", "minLength": 1},
        "evidence_type": {"enum": ["archived_snapshot", "versioned_repository_state", "versioned_release", "dated_preserved_copy", "other_historical_record"]},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "temporalAssessmentSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_version_reconstructable", "assessed_historical_version", "version_evidence_ids", "historical_version_evidence"],
      "properties": {
        "historical_version_reconstructable": {"type": "boolean"},
        "assessed_historical_version": {"enum": ["original", "archived_update", "not_reconstructable"]},
        "version_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "historical_version_evidence": {"type": "array", "items": {"$ref": "#/$defs/historicalVersionEvidence"}}
      }
    },
    "dimensionApplicability": {
      "type": "object", "additionalProperties": false, "required": ["C", "J"],
      "properties": {
        "C": {"type": "object", "additionalProperties": false, "required": ["applicable", "basis", "rationale"], "properties": {"applicable": {"type": "boolean"}, "basis": {"enum": ["author_technical_claim", "none"]}, "rationale": {"type": "string", "minLength": 1}}},
        "J": {"type": "object", "additionalProperties": false, "required": ["applicable", "basis", "broad_promise_requires_user_perspective", "rationale"], "properties": {"applicable": {"type": "boolean"}, "basis": {"enum": ["user_experience_presented", "user_experience_used", "user_experience_generalized", "promise_requires_user_perspective", "none"]}, "broad_promise_requires_user_perspective": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}}}
      }
    },
    "dimensionScopeCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "confirmed_correct_subject", "shared_with_dimensions", "distinct_effect"],
      "properties": {
        "subject": {"enum": ["facts", "law_and_norms", "technology", "evidence", "completeness", "reasoning", "terminology", "structure_and_comprehension", "action_safety", "user_experience", "epistemic_status", "promise_and_fit"]},
        "confirmed_correct_subject": {"const": true},
        "shared_with_dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]}},
        "distinct_effect": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "dimensionScopeChecks": {
      "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"],
      "properties": {"A": {"$ref": "#/$defs/dimensionScopeCheck"}, "B": {"$ref": "#/$defs/dimensionScopeCheck"}, "C": {"$ref": "#/$defs/dimensionScopeCheck"}, "D": {"$ref": "#/$defs/dimensionScopeCheck"}, "E": {"$ref": "#/$defs/dimensionScopeCheck"}, "F": {"$ref": "#/$defs/dimensionScopeCheck"}, "G": {"$ref": "#/$defs/dimensionScopeCheck"}, "H": {"$ref": "#/$defs/dimensionScopeCheck"}, "I": {"$ref": "#/$defs/dimensionScopeCheck"}, "J": {"$ref": "#/$defs/dimensionScopeCheck"}, "K": {"$ref": "#/$defs/dimensionScopeCheck"}, "L": {"$ref": "#/$defs/dimensionScopeCheck"}}
    },
    "decidabilityTest": {
      "type": "object", "additionalProperties": false,
      "required": ["main_content_or_core_artifact_missing", "external_supporting_evidence_missing", "auxiliary_data_missing", "core_assessment_possible", "rationale"],
      "properties": {"main_content_or_core_artifact_missing": {"type": "boolean"}, "external_supporting_evidence_missing": {"type": "boolean"}, "auxiliary_data_missing": {"type": "boolean"}, "core_assessment_possible": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}}
    },
    "contextSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["outlet_type", "outlet_declared_purpose", "declared_audiences", "article_audiences", "actually_required_knowledge", "conflicts", "profile_status", "profile_confidence"],
      "properties": {
        "outlet_type": {"type": "string", "minLength": 1}, "outlet_declared_purpose": {"type": "string", "minLength": 1},
        "declared_audiences": {"type": "array", "items": {"type": "string", "minLength": 1}}, "article_audiences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "actually_required_knowledge": {"type": "array", "items": {"type": "string", "minLength": 1}}, "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "profile_status": {"enum": ["ustalony", "czesciowo_ustalony", "nieustalony_wiarygodnie"]}, "profile_confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "groupScore": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "significant", "included_in_article_promise", "group_h_score", "group_l_score"],
      "properties": {"audience": {"type": "string", "minLength": 1}, "significant": {"type": "boolean"}, "included_in_article_promise": {"type": "boolean"}, "group_h_score": {"type": "integer", "minimum": 0, "maximum": 4}, "group_l_score": {"type": "integer", "minimum": 0, "maximum": 4}}
    },
    "audienceLanguage": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_audience", "popularizing_purpose", "unexplained_core_terms_block_nonspecialists", "core_requires_undisclosed_specialist_knowledge", "core_unrecoverable_without_expert", "group_scores"],
      "properties": {
        "primary_audience": {"type": "string", "minLength": 1}, "popularizing_purpose": {"type": "boolean"},
        "unexplained_core_terms_block_nonspecialists": {"type": "boolean"}, "core_requires_undisclosed_specialist_knowledge": {"type": "boolean"},
        "core_unrecoverable_without_expert": {"type": "boolean"}, "group_scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/groupScore"}}
      }
    },
    "languageBarrier": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["locations", "audience_groups", "terms_or_structural_elements", "affected_dimensions"],
      "properties": {
        "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "audience_groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terms_or_structural_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["G", "H", "L"]}}
      }
    },
    "mediumLargeBoundaryTest": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["significant_audience_group", "minimal_honest_correction", "action_or_conclusion_before", "action_or_conclusion_after", "changes_important_scope_or_action", "groups_repeated_occurrences", "single_correction_repairs_all_occurrences", "same_audience_effect", "rationale"],
      "properties": {"significant_audience_group": {"type": "string", "minLength": 1}, "minimal_honest_correction": {"type": "string", "minLength": 1}, "action_or_conclusion_before": {"type": "string", "minLength": 1}, "action_or_conclusion_after": {"type": "string", "minLength": 1}, "changes_important_scope_or_action": {"type": "boolean"}, "groups_repeated_occurrences": {"type": "boolean"}, "single_correction_repairs_all_occurrences": {"type": ["boolean", "null"]}, "same_audience_effect": {"type": ["boolean", "null"]}, "rationale": {"type": "string", "minLength": 1}}
    },
    "criticalityTest": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["confirmed_error_or_very_high_confidence", "likely_application", "serious_harm_possible", "no_simple_safeguard", "directly_actionable_instruction_with_possible_serious_effects", "failed_prerequisite", "rationale"],
      "properties": {"confirmed_error_or_very_high_confidence": {"type": "boolean"}, "likely_application": {"type": "boolean"}, "serious_harm_possible": {"type": "boolean"}, "no_simple_safeguard": {"type": "boolean"}, "directly_actionable_instruction_with_possible_serious_effects": {"type": "boolean"}, "failed_prerequisite": {"enum": ["confirmed_error_or_very_high_confidence", "likely_application", "serious_harm_possible", "no_simple_safeguard", null]}, "rationale": {"type": "string", "minLength": 1}}
    },
    "calibrationIssue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "severity", "centrality", "centrality_rationale", "application_risk", "application_risk_rationale", "medium_large_boundary_test", "criticality_test", "language_barrier", "confidence"],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^P-[0-9]{3,}$"}, "severity": {"enum": ["krytyczne", "duze", "srednie", "male"]},
        "centrality": {"enum": ["rdzen", "istotne_wsparcie", "element_poboczny"]}, "centrality_rationale": {"type": "string", "minLength": 1},
        "application_risk": {"enum": ["wysokie", "srednie", "niskie"]}, "application_risk_rationale": {"type": "string", "minLength": 1},
        "medium_large_boundary_test": {"$ref": "#/$defs/mediumLargeBoundaryTest"}, "criticality_test": {"$ref": "#/$defs/criticalityTest"},
        "language_barrier": {"$ref": "#/$defs/languageBarrier"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
